# Installed packages (recreated by "npm install")
node_modules/

# Docusaurus build output and cache (recreated by "npm run build")
build/
.docusaurus/
.cache-loader/

# Local environment files (may contain secrets)
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Mac system files
.DS_Store
